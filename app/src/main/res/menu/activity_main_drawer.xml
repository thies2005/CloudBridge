<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:showIn="navigation_view">

    <group
        android:id="@+id/nav_top"
        android:orderInCategory="0"
        android:checkableBehavior="single">
        <item
            android:id="@+id/nav_remotes"
            android:icon="@drawable/ic_twotone_cloud_24"
            android:title="@string/remotes" />
        <item
            android:id="@+id/nav_tasks"
            android:icon="@drawable/ic_round_swap_vert_24"
            android:title="@string/tasks" />
        <item
            android:id="@+id/nav_trigger"
            android:icon="@drawable/ic_round_av_timer_24"
            android:title="@string/trigger" />
        <item
            android:id="@+id/nav_logs"
            android:icon="@drawable/ic_round_list_24"
