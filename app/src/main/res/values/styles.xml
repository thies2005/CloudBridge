<resources>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:navigationBarColor">?attr/android:colorBackground</item>
    </style>


    <style name="HiddenWindowShortcutSyncStartTheme" parent="android:Theme">
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowDisablePreview">true</item>

        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="DialogThemeFullScreen">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
    </style>



    <!-- Layout Styles _____ Begin -->
    <!-- Card Styles need to be applied to the card directly.-->
    <style name="MainViewToolbar">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:tint">?attr/colorOnSurface</item>
        <item name="tint">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="actionMenuTextColor">?attr/colorOnSurface</item>
        <item name="android:actionMenuTextColor">?attr/colorOnSurface</item>
        <item name="popupTheme">@style/MainViewToolbarOverflowMenu</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
    </style>

    <style name="MainViewToolbarOverflowMenu" parent="ThemeOverlay.Material3">
        <item name="popupMenuStyle">@style/Widget.CloudBridge.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.CloudBridge.PopupMenu.Overflow</item>
    </style>

    <style name="FloatingActionButtonMulti">
        <item name="colorAccent">?attr/colorPrimaryContainer</item>
    </style>

    <style name="FileListItem">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

    <style name="FileListItemDescription">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:tint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="FileListBottomBars">
        <item name="android:textColor">?attr/colorOnTertiary</item>
        <item name="android:tint">?attr/colorOnTertiary</item>
        <item name="android:background">?attr/colorTertiary</item>
        <item name="cardBackgroundColor">?attr/colorTertiary</item>
    </style>

    <style name="SettingsTheme">
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <!-- Card Styles need to be applied to the card directly.-->
    <style name="PrimaryCardStyle">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="android:tint">?attr/colorOnPrimaryContainer</item>
    </style>

    <style name="SecondaryCardStyle">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

    <style name="RoundedCornersDialog" parent="@style/MaterialAlertDialog.Material3">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Dialog.Rounded</item>
    </style>
    <style name="ShapeAppearanceOverlay.Dialog.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/dialogCornerRadius</item>
    </style>
    <style name="BreadcrumbText" parent="">
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <!-- Splash screen entry theme (androidx.core:core-splashscreen). MainActivity calls
         SplashScreen.installSplashScreen(this); postSplashScreenTheme restores the real theme. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">?attr/colorSurface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
